{
  "version": 1,
  "phase": "initial-dev",
  "docRoot": {
    "requirements": [
      "docs/core/requirements",
      "docs/cli/requirements",
      "docs/vsc/requirements",
      "docs/desktop/requirements",
      "docs/RELEASE.md"
    ],
    "specs": "docs/core/requirements",
    "design": [
      "docs/core/design",
      "docs/cli/design",
      "docs/vsc/design",
      "docs/desktop/design",
      "docs/render-core/design"
    ],
    "modules": "docs/core/design/modules",
    "batches": "docs/batches"
  },
  "promptsLanding": "thincoder-core/prompts",
  "checkConfig": {
    "scanDirs": [
      "docs"
    ],
    "lineWidth": 300,
    "anchors": {
      "domain": "docs",
      "exclude": [
        "_archive",
        "batches"
      ]
    },
    "exemptions": []
  }
}
