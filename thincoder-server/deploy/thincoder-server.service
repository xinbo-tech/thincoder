# thincoder-server.service — systemd unit 模板（裸机路——ops/OPS.md §5.2；容器路 = compose restart 策略，不用本档）
#
# 装机（前缀式——自升前提 §5.1；以服务账号运行，前缀 = 下方 Environment）：
#   NPM_CONFIG_PREFIX=/opt/thincoder-server/.npm-global npm i -g @thincoder/server
# 安放（三步）：
#   ① cp thincoder-server.service /etc/systemd/system/
#   ② systemctl daemon-reload
#   ③ systemctl enable --now thincoder-server     # enable = 开机自启；--now = 立即启动
#
# 日志：stdout 单行 JSON 由 journald 收 —— journalctl -u thincoder-server -f
# 配置：--config 指机本地 config.json（不入 git）；provider keys ∥ bootstrap 口令走 env（EnvironmentFile）；
#       改配置 ⇒ 改档 + systemctl restart（设计口径：配置不热载）。
[Unit]
Description=Thincoder Server（内网 token 网关 + 控制台）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 运行账号（按部署机调整——专用非 root 账号，且对配置档 ∥ data/ ∥ npm 前缀可读可写）
User=thincoder
WorkingDirectory=/opt/thincoder-server
# env：provider keys ∥ bootstrap 口令（env: 引用）；行首「-」= 档缺失不报错
EnvironmentFile=-/etc/thincoder-server.env
# 更新/自升前提（§5.2）：npm 前缀/缓存 = 服务账号可写目录（装机与自升同前缀——§5.1）
Environment=NPM_CONFIG_PREFIX=/opt/thincoder-server/.npm-global
Environment=NPM_CONFIG_CACHE=/opt/thincoder-server/.npm-cache
# ExecStart = 前缀垫片（npm i -g 装机——§5.1）；进程退出（含自升成功）⇒ Restart=always 重起拾新版（§5.2）
ExecStart=/opt/thincoder-server/.npm-global/bin/thincoder-server --config /opt/thincoder-server/config.json
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
